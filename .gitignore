# ---- NEVER COMMIT PERSONAL DATA ----
# The database contains your full social graph and DM history.
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Liker/follower exports: these name real third parties, with display names
# and stable Instagram ids. Never commit them.
*likers*.csv
all_instagram_likers.csv
*_likers.csv
# Everything the API pull writes. These name thread participants and
# commenters, so the patterns are explicit rather than relying on data/ alone.
data/pulls/
threads.csv
comments.csv
dm_threads.csv
post_comments.csv

# Raw Instagram exports and bookmarklet captures
exports/
captures/
*.zip
instagram-*/
meta-*/

# Local config (may contain absolute paths to your watched folders)
.env
.env.local
config.local.json

# ---- standard ----
__pycache__/
*.pyc
node_modules/
dist/
build/
.vite/
coverage/
*.log
.DS_Store
